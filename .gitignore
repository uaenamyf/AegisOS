

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
build/
dist/

# --- Lint / type / test caches ---
.ruff_cache/
.mypy_cache/
.pytest_cache/
.cache/
.coverage
htmlcov/

# --- Runtime databases & logs ---
*.db
*.sqlite
*.sqlite3
logs/
*.log

# --- Generated drill records (runtime) ---
data/drills/

# --- OS / editor artifacts ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Frontend (also covered by frontend/.gitignore) ---
frontend/node_modules/
.vite/
frontend/dist/
frontend/.tsbuildinfo
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# --- Environment files（保留 .env.example，忽略实际 .env）---
.env
tooling/configs/.env
frontend/.env
frontend/.env.local

# --- Agent local notes ---
memory/
# AegisOS 智能体记忆源码目录（aegisos_agents/memory 与 tests/aegisos_agents/memory）
# 是版本化源码，需排除根层级 memory/ 忽略规则的影响
!aegisos_agents/memory/
!aegisos_agents/memory/**
!tests/aegisos_agents/memory/
!tests/aegisos_agents/memory/**
# 重新忽略源码目录下的字节码缓存（上方 ! 会穿透 __pycache__/）
aegisos_agents/memory/**/__pycache__/
tests/aegisos_agents/memory/**/__pycache__/
aegisos_agents/memory/**/*.pyc
tests/aegisos_agents/memory/**/*.pyc

# --- Agent local attachments ---
.opensquilla/
