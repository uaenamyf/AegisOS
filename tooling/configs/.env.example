# @aegis-gen
# date: 2026-07-04
# dev: Claude Code (glm-5.2)
# change: 新建统一环境变量模板——所有 API 地址/端口/密钥/中间件配置的唯一入口
# =============================================================================
# AegisOS 统一环境变量配置
# =============================================================================
# 用法:
#   1. cp tooling/configs/.env.example tooling/configs/.env
#   2. 按需修改值（开发环境默认值已预填）
#   3. 后端通过 tooling/configs/settings.py 自动加载
#   4. 前端通过 frontend/.env（符号链接或复制）由 Vite 自动注入 import.meta.env
#
# 优先级（高 → 低）: 环境变量 > .env 文件 > defaults.yaml > 代码默认值

# --- 后端 (Backend / FastAPI) ---
AEGIS_BACKEND_HOST=0.0.0.0
AEGIS_BACKEND_PORT=8000
AEGIS_BACKEND_VERSION=0.1.0

# --- 前端 (Frontend / Vite) ---
AEGIS_FRONTEND_HOST=localhost
AEGIS_FRONTEND_PORT=5173

# --- CORS ---
# 逗号分隔的来源列表
AEGIS_CORS_ENABLED=true
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API 鉴权 ---
AEGIS_AUTH_ENABLED=true
AEGIS_AUTH_MODE=api-key
AEGIS_AUTH_API_KEY_HEADER=X-API-Key
AEGIS_AUTH_DEFAULT_KEY=aegis-dev-key

# --- 数据库 ---
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./data/aegisos.db
AEGIS_DATABASE_ECHO=false

# --- 日志 ---
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s

# --- 限流 ---
AEGIS_RATE_LIMIT_ENABLED=true
AEGIS_RATE_LIMIT_RPM=120

# --- Trace ---
AEGIS_TRACE_ENABLED=true
AEGIS_TRACE_HEADER=X-Trace-Id

# --- 前端 API / WS 地址（Vite 注入 import.meta.env）---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/v1/stream
